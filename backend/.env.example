# ============================================================
#  ResumeAI Backend — Environment Variables Template
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit `.env` to git — only commit `.env.example`.
# ============================================================

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
# WARNING: SUPABASE_SERVICE_ROLE_KEY has full DB admin access. Keep it secret!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Admin Seed ──────────────────────────────────────────────────────────────
# Used ONE TIME only for POST /api/auth/seed-admin endpoint.
# Choose a long, random string. Comment out the route after first use.
ADMIN_SEED_KEY=choose_a_long_random_secret_key_here

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS (Production) ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your deployed frontend URL for production.
# Example: http://localhost:3000,https://your-deployed-app.com
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email Delivery Configuration (Password Reset & OTPs) ─────────────────────
# Gmail SMTP via Nodemailer — Primary OTP delivery mechanism.
#
# ⚠️  IMPORTANT: MAIL_PASSWORD MUST be a Gmail App Password (16 characters).
#     It is NOT your regular Gmail login password.
#     Steps to generate:
#       1. Enable 2-Step Verification on your Google account.
#       2. Go to https://myaccount.google.com/apppasswords
#       3. Create an App Password for "Mail" → copy the 16-character code.
#       4. Paste it below (no spaces).
#
# Port Guide:
#   Port 465 → Implicit SSL/TLS  (recommended, MAIL_SECURE = true internally)
#   Port 587 → STARTTLS           (MAIL_SECURE = false, upgraded after connect)
#
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your_16_char_gmail_app_password_here
MAIL_FROM=your-gmail@gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# [DEV FALLBACK] If MAIL_USERNAME / MAIL_PASSWORD are not set above,
# ResumeAI automatically uses Nodemailer Ethereal to generate a clickable
# web email preview link in your server console — no real email is sent!
FRONTEND_URL=http://localhost:3000

# ─── Redis (Production Rate Limiting) ────────────────────────────────────────
# Optional. When set, rate-limit counters are shared across all backend
# instances via Redis, preventing bypass in load-balanced multi-node deployments.
# If not set, the default in-memory store is used (fine for single-node / dev).
# Example: redis://localhost:6379  or  rediss://user:pass@your-redis-host:6380
# REDIS_URL=redis://localhost:6379
