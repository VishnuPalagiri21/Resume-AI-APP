# ============================================================
#  ResumeAI Backend — Environment Variables Template
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit `.env` to git — only commit `.env.example`.
# ============================================================

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from: https://supabase.com → Your Project → Settings → API
# WARNING: SUPABASE_SERVICE_ROLE_KEY has full DB admin access. Keep it secret!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── Admin Seed ──────────────────────────────────────────────────────────────
# Used ONE TIME only for POST /api/auth/seed-admin endpoint.
# Choose a long, random string. Comment out the route after first use.
ADMIN_SEED_KEY=choose_a_long_random_secret_key_here

# ─── Gemini AI ───────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS (Production) ───────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Add your deployed frontend URL for production.
# Example: http://localhost:3000,https://your-deployed-app.com
ALLOWED_ORIGINS=http://localhost:3000

# ─── Email Delivery Configuration (Password Reset & OTPs) ─────────────────────
# 1. [RECOMMENDED - NO APP PASSWORD HEADACHES] Resend (https://resend.com)
# Get a free API key (3,000 emails/month free) and uncomment below:
# RESEND_API_KEY=re_123456789
# EMAIL_FROM="ResumeAI Security <onboarding@resend.dev>"

# 2. [LEGACY] SMTP Configuration (Optional alternative to Resend)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-16-char-app-password

# 3. [DEFAULT DEV MODE] If neither Resend nor SMTP is configured above,
# ResumeAI automatically uses Nodemailer Ethereal to generate a clickable
# web email preview link in your server console!
FRONTEND_URL=http://localhost:3000
